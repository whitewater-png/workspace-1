{
  "id": "com.topaz.effectfolderorganizer",
  "name": "Effect Folder Organizer",
  "version": "0.1.0",
  "main": "index.html",
  "manifestVersion": 5,
  "host": [
    {
      "app": "PPRO",
      "minVersion": "24.6.0"
    }
  ],
  "entrypoints": [
    {
      "type": "panel",
      "id": "effectFolderOrganizerPanel",
      "label": {
        "default": "Effect Folder Organizer"
      },
      "minimumSize": { "width": 320, "height": 480 },
      "maximumSize": { "width": 1024, "height": 2048 },
      "preferredDockedSize": { "width": 420, "height": 720 },
      "preferredFloatingSize": { "width": 420, "height": 720 },
      "icons": [
        {
          "width": 23,
          "height": 23,
          "path": "assets/icons/logo.svg",
          "scale": [1, 2],
          "theme": ["darkest", "dark", "medium", "lightest", "light", "all"]
        }
      ]
    }
  ],
  "requiredPermissions": {
    "localFileSystem": "request",
    "clipboard": "readAndWrite"
  },
  "icons": [
    {
      "width": 48,
      "height": 48,
      "path": "assets/icons/logo.svg",
      "scale": [1, 2],
      "theme": ["darkest", "dark", "medium", "lightest", "light", "all"]
    }
  ]
}
